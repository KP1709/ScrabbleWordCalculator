echo "Run Cypress tests before pushing?"
printf " [y/n] "

if read -r ANSWER < /dev/tty; then
  case "$ANSWER" in n)
      echo "Skipping Cypress tests. Proceeding with git push."
      exit 0
      ;;
  esac
fi

echo "Running Cypress tests..."
pnpx cypress run
RESULT=$?

if [ $RESULT -ne 0 ]; then
  echo "❌ Cypress tests failed. Git push aborted."
  exit 1
fi

echo "✅ All Cypress tests passed."
exit 0